# Pi Boost — Environment Variables
#
# Copy this file to .env and fill in your values.
# The app works without Supabase (guest/offline mode).
# Add Supabase credentials to enable cloud sync + auth.

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_NAME=Pi Boost
VITE_APP_VERSION=1.0.0
